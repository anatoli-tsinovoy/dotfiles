{
  "servers": {
    "typescript-language-server": {
      "disabled": true
    },
    "typescript-native": {
      "command": "tsc",
      "args": ["--lsp", "--stdio"],
      "fileTypes": [".ts", ".tsx", ".mts", ".cts", ".js", ".jsx", ".mjs", ".cjs"],
      "rootMarkers": ["package.json", "tsconfig.json", "jsconfig.json", ".git"]
    },
    "pyright": {
      "disabled": true
    },
    "basedpyright": {
      "disabled": true
    },
    "pylsp": {
      "disabled": true
    },
    "ty": {
      "command": "ty",
      "args": ["server"],
      "fileTypes": [".py", ".pyi"],
      "rootMarkers": ["pyproject.toml", "requirements.txt", "setup.py", "setup.cfg", ".git"]
    },
    "ruff": {
      "rootMarkers": ["pyproject.toml", "ruff.toml", ".ruff.toml", "requirements.txt", ".git"]
    },
    "dartls": {
      "command": "dart",
      "args": ["language-server", "--protocol=lsp"],
      "fileTypes": [".dart"],
      "languageId": "dart",
      "rootMarkers": ["pubspec.yaml", "pubspec.lock"],
      "initOptions": {
        "closingLabels": true,
        "flutterOutline": true,
        "outline": true
      }
    }
  }
}
