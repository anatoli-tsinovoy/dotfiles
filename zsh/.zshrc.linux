# Linux-specific zsh configuration
# Sourced from ~/.zshrc on Linux systems (including Termux)

# fzf shell integration
if [[ -z "${OMPCODE:-}" ]]; then
  if [[ -f "$HOME/.fzf.zsh" ]]; then
    source "$HOME/.fzf.zsh"
  elif (( $+commands[fzf] )); then
    source <(command fzf --zsh)
  fi
fi

# code -> cursor alias (if cursor exists but code doesn't)
if ! command -v code &>/dev/null && command -v cursor &>/dev/null; then
  alias code="cursor"
fi

# Force Kitty graphics for Oh My Pi; the timg wrapper below does the same.
export PI_FORCE_IMAGE_PROTOCOL=kitty

# OMP binds the stats dashboard to container loopback. Mirror that port onto the
# container interface so the host can reach it through the existing SSH tunnel.
_omp_stats_with_container_relay() {
  local port=3847 container_ip="${OMP_STATS_RELAY_HOST:-}" relay_pid exit_status=1
  local arg address
  local -a args host_addresses
  local index
  args=("$@")

  for (( index = 1; index <= ${#args}; index++ )); do
    arg="${args[$index]}"
    case "$arg" in
      --host|--host=*|-j|--json|-s|--summary|-h|--h??p)
        command omp stats "$@"
        return
        ;;
      -p|--port)
        (( index++ ))
        port="${args[$index]:-}"
        ;;
      --port=*)
        port="${arg#--port=}"
        ;;
    esac
  done

  if [[ "$port" != <-> ]] || (( port < 1 || port > 65535 )); then
    command omp stats "$@"
    return
  fi

  if [[ -z "$container_ip" ]] && command -v ip &>/dev/null; then
    while read -r _ _ _ address _; do
      container_ip="${address%/*}"
      break
    done < <(command ip -o -4 addr show dev eth0 scope global 2>/dev/null)
  fi
  if [[ -z "$container_ip" ]] && command -v hostname &>/dev/null; then
    host_addresses=("${(@s: :)$(command hostname -i 2>/dev/null)}")
    container_ip="${host_addresses[1]:-}"
  fi
  if [[ "$container_ip" != <->.<->.<->.<-> ]]; then
    print -u2 'omp stats: could not determine the container IPv4 address'
    return 1
  fi
  if ! command -v uvx &>/dev/null; then
    print -u2 'omp stats: uvx is required for the container port relay'
    return 1
  fi

  print -u2 "omp stats: relaying ${container_ip}:${port} -> 127.0.0.1:${port}"
  command uvx --from 'websocat==1.13.0' websocat -q -b -E \
    "tcp-l:${container_ip}:${port}" "tcp:127.0.0.1:${port}" &
  relay_pid=$!

  {
    command omp stats "$@"
    exit_status=$?
  } always {
    command kill "$relay_pid" 2>/dev/null
    wait "$relay_pid" 2>/dev/null
  }
  return "$exit_status"
}

omp() {
  if is_inside_container && [[ "$1" == stats ]]; then
    shift
    _omp_stats_with_container_relay "$@"
  else
    command omp "$@"
  fi
}

# Use the host-side PulseAudio tunnel, via loopback or the container gateway.
if [[ -z "${PULSE_SERVER:-}" ]]; then
  _pulse_server_host=127.0.0.1
  if is_inside_container && command -v ip &>/dev/null; then
    while read -r _route _via _gateway _rest; do
      if [[ "$_route" == default && "$_via" == via && -n "$_gateway" ]]; then
        _pulse_server_host="$_gateway"
      fi
      break
    done < <(command ip route show default)
  fi
  export PULSE_SERVER="tcp:$_pulse_server_host:${PULSE_FORWARD_PORT:-47130}"
  unset _pulse_server_host _route _via _gateway _rest
fi

# timg wrapper: default to Kitty protocol; explicit -p* overrides it
timg() {
  local has_protocol=false
  local arg

  for arg in "$@"; do
    [[ "$arg" == "--" ]] && break
    if [[ "$arg" == "-p"* ]]; then
      has_protocol=true
      break
    fi
  done

  if $has_protocol; then
    command timg "$@"
  else
    command timg -pk "$@"
  fi
}
