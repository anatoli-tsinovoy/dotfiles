#!/usr/bin/env bash
# Report the Python version starship should display, mirroring how `uv run`
# picks an interpreter instead of trusting whatever `python3` is on PATH.
#
# Used as starship's `python_binary`: starship invokes this with `--version` and
# parses the second whitespace-separated token, so the output shape must stay
# `Python <version>`.
#
# Resolution order (first hit wins; no interpreter is executed for 1-3):
#   1. $VIRTUAL_ENV                  - an explicitly activated venv
#   2. $UV_PROJECT_ENVIRONMENT / nearest .venv (walking up from $PWD, like uv)
#   3. nearest .python-version       - the version uv would materialize
#   4. real python3/python on PATH   - non-uv, non-venv fallback
set -uo pipefail

emit() {
  [[ -n ${1:-} ]] || return 1
  printf 'Python %s\n' "$1"
  exit 0
}

# Trims surrounding whitespace into $REPLY (no subshell: this runs per prompt).
trim() {
  REPLY="$1"
  REPLY="${REPLY#"${REPLY%%[![:space:]]*}"}"
  REPLY="${REPLY%"${REPLY##*[![:space:]]}"}"
}

# pyvenv.cfg carries `version_info = 3.13.5` (uv, and stdlib venv since 3.11);
# older stdlib venvs only write `version = 3.10.12`.
emit_venv_version() {
  local cfg="$1/pyvenv.cfg" key line legacy=""
  [[ -r $cfg ]] || return 1
  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line == *=* ]] || continue
    trim "${line%%=*}"
    key="$REPLY"
    trim "${line#*=}"
    case "$key" in
      version_info) emit "$REPLY" ;;
      version) legacy="$REPLY" ;;
    esac
  done <"$cfg"
  emit "$legacy"
}

# .python-version may hold `3.13`, `3.13.5`, `cpython@3.13`, `3.13t`, or several
# lines (uv treats the first request as the default). Named or path requests are
# left to the fallback since resolving them needs uv itself.
emit_python_version_file() {
  local file="$1/.python-version" line spec
  [[ -r $file ]] || return 1
  while IFS= read -r line || [[ -n $line ]]; do
    trim "${line%%#*}"
    [[ -n $REPLY ]] || continue
    spec="${REPLY##*@}"
    [[ $spec == [0-9]* ]] && emit "$spec"
    return 1
  done <"$file"
  return 1
}

if [[ -n ${VIRTUAL_ENV:-} ]]; then
  emit_venv_version "$VIRTUAL_ENV"
  exec "$VIRTUAL_ENV/bin/python" --version 2>/dev/null
fi

uv_env="${UV_PROJECT_ENVIRONMENT:-}"
if [[ ${uv_env:0:1} == / ]]; then
  emit_venv_version "$uv_env"
  uv_env=""
fi

dir="$PWD"
while :; do
  [[ -n $uv_env ]] && emit_venv_version "$dir/$uv_env"
  emit_venv_version "$dir/.venv"
  emit_venv_version "$dir/venv"
  emit_python_version_file "$dir"
  [[ -z $dir || $dir == / ]] && break
  dir="${dir%/*}"
done

command -v python3 >/dev/null && exec python3 --version
exec python --version
