#!/usr/bin/env bash
set -euo pipefail

timeout_seconds=5
if command -v timeout &>/dev/null; then
  timeout_command=timeout
else
  timeout_command=gtimeout
fi

arn="$("$timeout_command" "$timeout_seconds" aws sts get-caller-identity \
  --cli-connect-timeout "$timeout_seconds" \
  --cli-read-timeout "$timeout_seconds" \
  --query Arn \
  --output text 2>/dev/null)"
[[ -n "$arn" && "$arn" != "None" ]]

case "$arn" in
  *:assumed-role/*)
    identity="${arn#*:assumed-role/}"
    identity="${identity%%/*}"
    ;;
  *:user/*)
    identity="${arn#*:user/}"
    ;;
  *)
    identity="${arn##*:}"
    ;;
esac

# SSO role names encode the permission-set name and a generated hexadecimal suffix.
if [[ "$identity" =~ ^AWSReservedSSO_(.+)_[[:xdigit:]]{16}$ ]]; then
  identity="${BASH_REMATCH[1]}"
fi

printf '%s\n' "$identity"
